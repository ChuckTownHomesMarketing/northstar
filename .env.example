# Postgres. Heroku sets this from the Postgres addon.
DATABASE_URL="postgresql://northstar:northstar@localhost:5432/northstar"

# openssl rand -base64 32
AUTH_SECRET=""

# Google Cloud OAuth client (Web application).
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Local: http://localhost:3000
# Heroku: https://your-app.herokuapp.com
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

ALLOWED_EMAIL_DOMAIN="chucktownhomes.com"

# Avery's real Google Workspace mailbox. Example only — confirm the address before deploy.
BOOTSTRAP_ADMIN_EMAIL=""
BOOTSTRAP_ADMIN_NAME="Avery French"

# true loads made-up numbers tagged as sample data. Keep false on Heroku.
SEED_DEMO_DATA="false"

# Local only. Ignored when NODE_ENV=production, including every Heroku dyno.
ENABLE_DEV_LOGIN="false"
