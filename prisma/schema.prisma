generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  VA
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  DONE
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Recurrence {
  DAILY
  WEEKLY
  MONTHLY
}

enum ContentStatus {
  IDEA
  DRAFTING
  REVIEW
  SCHEDULED
  POSTED
}

enum ContentChannel {
  INSTAGRAM
  FACEBOOK
  TIKTOK
  YOUTUBE
  LINKEDIN
  EMAIL
  BLOG
  GOOGLE_BUSINESS
  OTHER
}

enum ContentType {
  POST
  REEL
  STORY
  BLOG_POST
  EMAIL_BLAST
  AD_CREATIVE
  VIDEO
  LISTING
  OTHER
}

enum LeadSource {
  META
  GOOGLE_ADS
  ZILLOW
  REALTOR
  REFERRAL
  ORGANIC
  OTHER
}

enum MetricOrigin {
  MANUAL
  CSV
  DEMO
  INTEGRATION
  WEBHOOK
}

enum AppOpenMode {
  EMBED
  EXTERNAL
}

enum OrderStatus {
  REQUESTED
  APPROVED
  ORDERED
  DELIVERED
}

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String
  image       String?
  role        Role      @default(VA)
  active      Boolean   @default(true)
  isDemo      Boolean   @default(false)
  googleSub   String?   @unique
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  contentItems ContentItem[]  @relation("ContentOwner")
  tasks        Task[]         @relation("TaskOwner")
  templates    TaskTemplate[] @relation("TemplateOwner")
  reports      WeeklyReport[]
  moduleGrants UserModuleGrant[]
  appGrants    UserAppGrant[]
  orders       ProductOrder[]
  auditChecks  AuditCheck[]
  auditSeats   AuditAssignee[]
  apiTokens    ApiToken[]     @relation("TokenSubject")
  tokensIssued ApiToken[]     @relation("TokenIssuer")
}

model Market {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  city        String
  state       String
  address     String?
  phone       String?
  active      Boolean  @default(true)
  openingNote String?
  sortOrder   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  kpis      MarketMonthKpi[]
  spend     SpendEntry[]
  content   ContentItem[]
  campaigns Campaign[]
  tasks     Task[]
  templates TaskTemplate[]
  leads     LeadRecord[]
  orders    ProductOrder[]
}

model AiTeammate {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  title     String
  askFor    String   @db.Text
  sortOrder Int
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model QuickLink {
  id          String   @id @default(cuid())
  label       String
  href        String
  description String?
  sortOrder   Int
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model MarketMonthKpi {
  id               String       @id @default(cuid())
  marketId         String
  market           Market       @relation(fields: [marketId], references: [id], onDelete: Cascade)
  year             Int
  month            Int
  leads            Int?
  adSpendCents     Int?
  costPerLeadCents Int?
  appointments     Int?
  closings         Int?
  websiteSessions  Int?
  socialFollowers  Int?
  socialEngagement Int?
  newGoogleReviews Int?
  avgRating        Decimal?     @db.Decimal(3, 2)
  notes            String?
  origin           MetricOrigin @default(MANUAL)
  isDemo           Boolean      @default(false)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([marketId, year, month])
  @@index([year, month])
}

model SpendEntry {
  id           String       @id @default(cuid())
  marketId     String
  market       Market       @relation(fields: [marketId], references: [id], onDelete: Cascade)
  source       LeadSource
  sourceDetail String       @default("")
  weekStart    DateTime     @db.Date
  spendCents   Int
  leads        Int
  appointments Int
  notes        String?
  origin       MetricOrigin @default(MANUAL)
  isDemo       Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@unique([marketId, source, sourceDetail, weekStart])
  @@index([weekStart])
}

model Campaign {
  id          String        @id @default(cuid())
  name        String
  marketId    String?
  market      Market?       @relation(fields: [marketId], references: [id], onDelete: SetNull)
  description String?
  startsOn    DateTime?     @db.Date
  endsOn      DateTime?     @db.Date
  isDemo      Boolean       @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  items       ContentItem[]
}

model ContentItem {
  id           String         @id @default(cuid())
  marketId     String?
  market       Market?        @relation(fields: [marketId], references: [id], onDelete: SetNull)
  campaignId   String?
  campaign     Campaign?      @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  channel      ContentChannel
  contentType  ContentType
  topic        String
  ownerId      String?
  owner        User?          @relation("ContentOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  status       ContentStatus  @default(IDEA)
  scheduledFor DateTime?      @db.Date
  link         String?
  notes        String?
  isDemo       Boolean        @default(false)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([scheduledFor])
  @@index([status])
}

model WeeklyReport {
  id          String   @id @default(cuid())
  weekStart   DateTime @db.Date @unique
  wins        String   @default("") @db.Text
  issues      String   @default("") @db.Text
  priorities  String   @default("") @db.Text
  isDemo      Boolean  @default(false)
  updatedById String?
  updatedBy   User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Task {
  id         String        @id @default(cuid())
  title      String
  details    String?
  marketId   String?
  market     Market?       @relation(fields: [marketId], references: [id], onDelete: SetNull)
  ownerId    String?
  owner      User?         @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  dueOn      DateTime?     @db.Date
  priority   TaskPriority  @default(MEDIUM)
  status     TaskStatus    @default(TODO)
  templateId String?
  template   TaskTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  periodKey  String?
  isDemo     Boolean       @default(false)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  @@unique([templateId, periodKey])
  @@index([status])
  @@index([dueOn])
}

model TaskTemplate {
  id         String       @id @default(cuid())
  title      String
  details    String?
  marketId   String?
  market     Market?      @relation(fields: [marketId], references: [id], onDelete: SetNull)
  ownerId    String?
  owner      User?        @relation("TemplateOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  priority   TaskPriority @default(MEDIUM)
  recurrence Recurrence
  weekday    Int?
  dayOfMonth Int?
  active     Boolean      @default(true)
  isDemo     Boolean      @default(false)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  tasks      Task[]
}

/// Reserved rows for later Meta, Google Ads, GA4, and CRM connections.
/// v1 never marks these connected and never invents metrics from them.
model IntegrationPlaceholder {
  id        String   @id @default(cuid())
  provider  String   @unique
  status    String   @default("not_connected")
  notes     String?
  updatedAt DateTime @updatedAt
}

model ModuleSetting {
  key         String  @id
  name        String
  description String
  enabled     Boolean @default(true)
  sortOrder   Int
  grants      UserModuleGrant[]
}

model UserModuleGrant {
  userId    String
  moduleKey String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  module    ModuleSetting @relation(fields: [moduleKey], references: [key], onDelete: Cascade)

  @@id([userId, moduleKey])
}

model LeadSourceDefinition {
  id          String       @id @default(cuid())
  slug        String       @unique
  name        String
  kind        String
  description String?
  active      Boolean      @default(true)
  sortOrder   Int
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  leads       LeadRecord[]
}

model LeadRecord {
  id            String               @id @default(cuid())
  sourceId      String
  source        LeadSourceDefinition @relation(fields: [sourceId], references: [id], onDelete: Restrict)
  marketId      String?
  market        Market?              @relation(fields: [marketId], references: [id], onDelete: SetNull)
  occurredOn    DateTime             @db.Date
  leads         Int
  spendCents    Int                  @default(0)
  appointments  Int                  @default(0)
  conversions   Int                  @default(0)
  externalId    String?
  contactName   String?
  contactEmail  String?
  notes         String?
  origin        MetricOrigin         @default(MANUAL)
  isDemo        Boolean              @default(false)
  createdById   String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@unique([sourceId, externalId])
  @@index([occurredOn])
}

model CatalogProduct {
  id             String         @id @default(cuid())
  name           String
  category       String
  description    String?
  unitPriceCents Int?
  active         Boolean        @default(true)
  isDemo         Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  orders         ProductOrder[]
}

model ProductOrder {
  id          String         @id @default(cuid())
  productId   String
  product     CatalogProduct @relation(fields: [productId], references: [id], onDelete: Restrict)
  quantity    Int
  requesterId String
  requester   User           @relation(fields: [requesterId], references: [id], onDelete: Cascade)
  marketId    String?
  market      Market?        @relation(fields: [marketId], references: [id], onDelete: SetNull)
  status      OrderStatus    @default(REQUESTED)
  notes       String?
  adminNote   String?
  isDemo      Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([status])
  @@index([requesterId])
}

model ExternalApp {
  id              String      @id @default(cuid())
  name            String
  icon            String      @default("")
  url             String
  openMode        AppOpenMode @default(EXTERNAL)
  active          Boolean     @default(true)
  sortOrder       Int
  visibleToAdmins Boolean     @default(true)
  visibleToVas    Boolean     @default(false)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  grants          UserAppGrant[]
}

model UserAppGrant {
  userId String
  appId  String
  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  app    ExternalApp @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@id([userId, appId])
}

model AuditTemplate {
  id         String   @id @default(cuid())
  title      String
  details    String?
  active     Boolean  @default(true)
  assignRole Role?
  sortOrder  Int
  isDemo     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  assignees  AuditAssignee[]
  checks     AuditCheck[]
}

model AuditAssignee {
  templateId String
  userId     String
  template   AuditTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([templateId, userId])
}

model AuditCheck {
  id          String        @id @default(cuid())
  templateId  String
  userId      String
  day         DateTime      @db.Date
  done        Boolean       @default(false)
  completedAt DateTime?
  template    AuditTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([templateId, userId, day])
  @@index([day])
}

/// Admin-set targets for the Marketing Health chart. Scores are never invented when the underlying numbers are missing.
model HealthTarget {
  key              String @id
  label            String
  target           Float
  secondaryTarget  Float?
  direction        String
  unit             String
  updatedAt        DateTime @updatedAt
}

model ApiToken {
  id          String    @id @default(cuid())
  name        String
  tokenHash   String    @unique
  prefix      String
  userId      String?
  user        User?     @relation("TokenSubject", fields: [userId], references: [id], onDelete: Cascade)
  scopes      String
  revokedAt   DateTime?
  lastUsedAt  DateTime?
  createdById String
  createdBy   User      @relation("TokenIssuer", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@index([userId])
}
